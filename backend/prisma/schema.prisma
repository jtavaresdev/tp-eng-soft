generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Subscription {
  id            Int      @id @default(autoincrement())
  nome          String
  valor         Decimal
  data_cobranca DateTime
  categoria     String
  status        String   @default("ativo")
  criado_em     DateTime @default(now())
  cancelado_em  DateTime?

  @@map("subscriptions")
}
