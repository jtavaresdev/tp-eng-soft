# --- Servidor ---
# Porta em que a API vai escutar
PORT=3001
# development | production
NODE_ENV=development
# Origem do frontend liberada no CORS (URL do Vite em desenvolvimento)
CORS_ORIGIN=http://localhost:5173

# --- Banco de dados ---
# Em desenvolvimento usamos SQLite (caminho do arquivo).
# Em producao/entrega, PostgreSQL (se aplicavel) - trocar por DATABASE_URL.
DB_PATH=file:./data/dev.db

# --- E-mail (Nodemailer / SMTP) ---
# Para testar sem enviar e-mail de verdade, use uma conta gratuita do Ethereal (https://ethereal.email)
# Para Gmail, use uma "senha de app" (nao a senha da conta).
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
# true para porta 465 (SSL), false para 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=seu_usuario
SMTP_PASS=sua_senha_ou_app_password
# Remetente que aparece no e-mail
MAIL_FROM="Gerenciador de Assinaturas <no-reply@exemplo.com>"

# --- Notificacoes ---
# E-mail que recebera os lembretes de renovacao (sistema single-user)
NOTIFY_EMAIL_TO=voce@exemplo.com
# Quantos dias antes da cobranca o lembrete deve ser enviado
NOTIFY_DAYS_BEFORE=3
# Horario do job diario (formato cron): todo dia as 08:00
CRON_SCHEDULE=0 8 * * *
